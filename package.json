{
	"name": "wp-devbench-plugin",
	"version": "1.0.0",
	"description": "A developer sandbox for WordPress that lets you run custom PHP functions, test code snippets, and debug outputs directly in the admin dashboard.",
	"author": "ColinMitchell",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"dist": "npm run build && composer install --no-dev --optimize-autoloader",
		"lint": "npm-run-all lint:*",
		"lint:css": "wp-scripts lint-style ./admin/src/*.scss ./admin/*.css",
		"lint:js": "wp-scripts lint-js ./admin/src",
		"format": "npm-run-all format:*",
		"format:js": "npm run lint:js -- --fix",
		"format:css": "npm run lint:css -- --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"env": "wp-env",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.0",
		"@types/uuid": "^10.0.0",
		"@wordpress/env": "^10.27.0",
		"@wordpress/scripts": "^30.20.0",
		"autoprefixer": "^10.4.21",
		"css-loader": "^7.1.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"mini-css-extract-plugin": "^2.9.2",
		"postcss-important": "^0.3.0",
		"postcss-loader": "^8.1.1",
		"prettier": "3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"style-loader": "^4.0.0",
		"tailwindcss": "^3.4.3",
		"tsconfig-paths-webpack-plugin": "^4.1.0",
		"tw-animate-css": "^1.3.6",
		"typescript": "^5.8.3",
		"webpack": "^5.101.0",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.2.1",
		"@radix-ui/react-alert-dialog": "^1.1.14",
		"@radix-ui/react-checkbox": "^1.3.2",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-hover-card": "^1.1.14",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-menubar": "^1.1.15",
		"@radix-ui/react-navigation-menu": "^1.2.13",
		"@radix-ui/react-popover": "^1.1.14",
		"@radix-ui/react-progress": "^1.1.7",
		"@radix-ui/react-radio-group": "^1.3.7",
		"@radix-ui/react-scroll-area": "^1.2.9",
		"@radix-ui/react-select": "^2.2.5",
		"@radix-ui/react-separator": "^1.1.7",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tabs": "^1.1.12",
		"@radix-ui/react-toast": "^1.2.14",
		"@radix-ui/react-toggle": "^1.1.9",
		"@radix-ui/react-toggle-group": "^1.1.10",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@rjsf/core": "^5.24.12",
		"@rjsf/utils": "^5.24.12",
		"@uiw/react-json-view": "^2.0.0-alpha.39",
		"@wordpress/hooks": "^4.27.0",
		"archiver": "^7.0.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cross-spawn": ">=7.0.6",
		"lucide-react": "^0.535.0",
		"npm-run-all": "^4.1.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.61.1",
		"react-resizable-panels": "^3.0.4",
		"react-router-dom": "^7.7.1",
		"tailwind-merge": "^2.3.0",
		"tailwindcss-animate": "^1.0.7",
		"uuid": "^11.1.0",
		"wretch": "^2.11.0"
	},
	"lint-staged": {
		"*.php": [
			"composer phpstan",
			"composer phpcs"
		]
	}
}
