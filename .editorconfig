# EditorConfig is awesome: https://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = tab
indent_size = 4
tab_width = 4

[*.js]
indent_style = tab
indent_size = 4
tab_width = 4

[*.css]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{json,yml,md,html,txt}]
indent_style = tab
indent_size = 4
tab_width = 4